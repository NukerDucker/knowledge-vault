# Obsidian — workspace state (changes every open, not config)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/.trash/

# Agent tooling — installed, not authored. Reinstallable from skills-lock.json,
# and nothing in the vault's content depends on it.
# .claude/settings.json stays tracked: it holds the vault's hooks (SessionStart
# tracker sync + report baseline, Stop reminder + session report).
.agents/
.claude/skills/
.claude/settings.local.json
.claude/worktrees/
skills-lock.json

# macOS
.DS_Store
**/.DS_Store

# Per-session agent report — churns every turn, no vault content depends on it.
.claude/reports/

# Generated calendar export — derived from note frontmatter; nothing imports it.
# Regenerate with: python3 _meta/sync-calendar.py
# The script stays tracked: it is the only vault-to-external-calendar path.
_meta/assignments.ics

# Private notes — symlinks into ~/Documents/Personal/, which lives outside the
# vault. This repo is public; nothing here is ever meant to be committed.
# Folder name stays generic on purpose: naming a file here would publish its topic.
_private/
